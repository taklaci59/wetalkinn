@{
    ViewData["Title"] = "DoWeTalk - Giriş";
}

<div class="hero-container">
    <div class="hero-content container">
        <div class="row align-items-center min-vh-100">
            <div class="col-lg-7 text-start">
                <h1 class="hero-title animate-pop-in">
                    Sadece Konuşma, <br />
                    <span class="glow-text">Deneyimle.</span>
                </h1>
                <p class="hero-subtitle mb-5">
                    DoWeTalk ile yüksek kaliteli sesli aramalar, dosya paylaşımı ve sana özel sunucularla arkadaşlarınla bağını koparma.
                </p>

                <div class="hero-btns">
                    <a asp-controller="Account" asp-action="Auth" class="btn btn-primary-neon me-3">
                        Hemen Başla
                    </a>
                    <button class="btn btn-outline-neon">
                        <i class="bi bi-play-fill"></i> Tanıtımı İzle
                    </button>
                </div>
            </div>

            <div class="col-lg-5 position-relative d-none d-lg-block">
                <div class="glow-sphere"></div>
                <img src="@Url.Content("~/images/DT2.png")" asp-append-version="true" class="img-fluid anime-hero-img" alt="DoWeTalk Anime Mascot">
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
}