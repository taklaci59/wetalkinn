@model DoWeTalk.Models.ApplicationUser
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DoWeTalk - Dashboard</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/themes.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <script>
        // ZERO-FLICKER: Apply theme immediately before rendering
        (function() {
            const savedTheme = localStorage.getItem('dwt-theme') || 'theme-dark';
            const savedAccent = localStorage.getItem('dwt-accent');
            document.documentElement.classList.add(savedTheme);
            if (savedAccent) {
                document.documentElement.style.setProperty('--accent', savedAccent);
                document.documentElement.style.setProperty('--accent-hover', savedAccent);
                document.documentElement.style.setProperty('--user-accent', savedAccent);
            }
        })();
    </script>

    <style>
        body, html {
            height: 100%;
            margin: 0;
            background-color: var(--bg-primary);
            color: var(--text-primary);
            font-family: 'Outfit', sans-serif;
            overflow: hidden;
        }

        .main-wrapper {
            display: flex;
            height: 100vh;
            width: 100vw;
            background-color: var(--bg-primary);
        }

        /* 1. SÜTUN: SUNUCULAR */
        .server-sidebar {
            width: 72px;
            background-color: var(--sidebar-bg);
            display: flex;
            flex-direction: column;
            align-items: center;
            padding-top: 12px;
            border-right: 1px solid var(--border-color);
        }

        .server-icon {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: var(--bg-secondary);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            color: var(--accent);
            font-weight: bold;
            font-size: 1.2rem;
            position: relative;
        }

            .server-icon:hover, .server-icon.active {
                border-radius: 15px;
                background: var(--accent);
                color: var(--accent-text);
            }

        /* 2. SÜTUN: LİSTE PANELİ */
        .left-panel {
            width: 240px;
            background-color: var(--bg-secondary);
            display: flex;
            flex-direction: column;
            border-right: 1px solid var(--border-color);
        }

        .panel-header {
            height: 60px;
            padding: 0 15px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
            font-weight: 600;
            color: var(--text-primary);
        }

        .list-container {
            flex: 1;
            padding: 10px;
            overflow-y: auto;
        }

        .nav-item {
            padding: 10px 12px;
            border-radius: 8px;
            color: var(--text-secondary);
            cursor: pointer;
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            transition: 0.2s;
        }

            .nav-item:hover, .nav-item.active {
                background: var(--hover-bg);
                color: var(--text-primary);
            }

        /* 3. SÜTUN: ANA İÇERİK */
        .main-content {
            flex: 1;
            background-color: var(--bg-primary);
            display: flex;
            flex-direction: column;
        }

        .top-nav {
            height: 60px;
            display: flex;
            align-items: center;
            padding: 0 20px;
            border-bottom: 1px solid var(--border-color);
            gap: 15px;
            background: var(--bg-primary);
        }

        .top-nav-btn {
            background: none;
            border: none;
            color: var(--text-secondary);
            padding: 5px 12px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: 600;
            transition: 0.2s;
        }

            .top-nav-btn.active {
                color: var(--text-primary);
                background: var(--active-bg);
            }

            .top-nav-btn.add-btn {
                color: var(--success);
            }

                .top-nav-btn.add-btn.active {
                    background: var(--hover-bg);
                    color: var(--success);
                }

        .user-footer {
            background: var(--bg-tertiary);
            padding: 8px 12px;
            display: flex;
            align-items: center;
            gap: 10px;
            border-top: 1px solid var(--border-color);
        }

        .status-indicator {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            border: 2px solid var(--bg-tertiary);
            position: absolute;
            bottom: 0;
            right: 0;
            background: var(--success);
        }

        .hidden {
            display: none !important;
        }

        .add-friend-wrapper {
            max-width: 600px;
        }

        .add-friend-input-container {
            background: var(--sidebar-dark);
            border: 1px solid rgba(0,0,0,0.3);
            border-radius: 8px;
            padding: 10px 15px;
            display: flex;
            align-items: center;
            transition: border 0.3s;
        }

            .add-friend-input-container:focus-within {
                border-color: var(--accent);
            }

            .add-friend-input-container input {
                background: transparent;
                border: none;
                color: white;
                flex: 1;
                outline: none;
                font-size: 1rem;
            }

        .request-card {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.05);
            transition: 0.2s;
        }

            .request-card:hover {
                background: rgba(255,255,255,0.05);
            }

        .message-item {
            margin-bottom: 20px;
        }

        .msg-sender {
            font-weight: 600;
            font-size: 0.9rem;
            margin-right: 8px;
        }

        .msg-time {
            font-size: 0.7rem;
            color: var(--text-muted);
        }

        .msg-content {
            color: #dcddde;
            word-wrap: break-word;
        }
    </style>
</head>
<body>

    <div class="main-wrapper">
        <div class="server-sidebar">
            <div class="server-icon active" onclick="showHome()" id="homeIcon">
                <i class="bi bi-house-door-fill"></i>
            </div>
            <hr style="width: 32px; border-color: var(--border-color)">
            <div id="serverListContainer"></div>
            <div class="server-icon text-success" style="border: 1px dashed var(--success);" data-bs-toggle="modal" data-bs-target="#createServerModal">
                <i class="bi bi-plus-lg"></i>
            </div>
        </div>

        <div class="left-panel">
            <div class="panel-header" id="leftPanelHeader">DoWeTalk</div>
            <div class="list-container" id="leftListContent">
                <div class="nav-item active" onclick="showHome()"><i class="bi bi-people-fill me-2"></i> Arkadaşlar</div>
                <div class="text-uppercase small fw-bold mt-4 mb-2 px-2" style="color: var(--text-muted); font-size: 11px;">Direkt Mesajlar</div>
                <div id="directMessagesList"></div>
            </div>

            <div class="user-footer">
                <div class="position-relative">
                    <div class="user-avatar" style="width: 32px; height: 32px; background-image: url('https://i.pravatar.cc/150?u=@Model.Id'); border-radius: 50%; background-size: cover; border: 1px solid var(--border-color);"></div>
                    <div class="status-indicator"></div>
                </div>
                <div class="flex-grow-1 overflow-hidden">
                    <div class="fw-bold text-truncate" style="font-size: 0.8rem; color: var(--text-primary);">@Model.UserName</div>
                    <div class="text-muted" style="font-size: 0.65rem;">Çevrimiçi</div>
                </div>
                <i class="bi bi-gear-fill cursor-pointer text-muted" data-bs-toggle="modal" data-bs-target="#settingsModal"></i>
            </div>
        </div>

        <div class="main-content">
            <div id="friendsView" class="h-100 flex-column d-flex">
                <div class="top-nav">
                    <i class="bi bi-people-fill text-muted fs-5"></i>
                    <span class="fw-bold">Arkadaşlar</span>
                    <div class="vr mx-2" style="height: 24px; opacity: 0.2;"></div>
                    <button class="top-nav-btn active" onclick="switchFriendTab('online', this)">Çevrimiçi</button>
                    <button class="top-nav-btn" onclick="switchFriendTab('all', this)">Tümü</button>
                    <button class="top-nav-btn" onclick="switchFriendTab('pending', this)">Bekleyenler</button>
                    <button class="top-nav-btn add-btn" onclick="switchFriendTab('add', this)">Arkadaş Ekle</button>
                </div>

                <div id="friendsListArea" class="p-4"></div>

                <div id="pendingArea" class="p-4 hidden">
                    <div class="text-uppercase small fw-bold text-muted mb-3">Bekleyen İstekler</div>
                    <div id="pendingRequestsList">
                        <div class="text-center mt-5 opacity-25 empty-msg">
                            <i class="bi bi-clock-history fs-1"></i>
                            <p class="mt-2">Bekleyen bir istek bulunmuyor.</p>
                        </div>
                    </div>
                </div>

                <div id="addFriendArea" class="p-4 hidden">
                    <div class="add-friend-wrapper">
                        <h5 class="fw-bold text-uppercase small mb-2">Arkadaş Ekle</h5>
                        <p class="text-muted small mb-4">Arkadaşlarını kullanıcı adlarıyla ekleyebilirsin.</p>
                        <div class="add-friend-input-container">
                            <input type="text" id="friendUsernameInput" placeholder="Kullanıcı adını yazın...">
                            <button class="btn btn-primary btn-sm px-3 fw-bold" style="background: var(--accent); border:none;" onclick="sendFriendRequest()">İstek Gönder</button>
                        </div>
                        <div id="addFriendStatus" class="mt-3"></div>
                    </div>
                </div>
            </div>

            <div id="chatView" class="hidden h-100 flex-column">
                <div class="top-nav">
                    <i class="bi bi-hash text-muted fs-4"></i>
                    <span class="fw-bold" id="chatHeaderName">genel</span>
                </div>
                <div class="messages-container flex-grow-1 p-4 overflow-auto" id="messageList"></div>
                <div class="p-3">
                    <div class="input-wrapper p-2 rounded-3 d-flex align-items-center" style="background: var(--bg-secondary); border: 1px solid var(--border-color);">
                        <i class="bi bi-plus-circle-fill mx-2 text-muted fs-5"></i>
                        <input type="text" id="chatInput" class="form-control bg-transparent border-0 text-white shadow-none" placeholder="Mesaj gönder...">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="createServerModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-0 shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title w-100 text-center fw-bold">Sunucunu Özelleştir</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <label class="small fw-bold text-muted mb-2">SUNUCU ADI</label>
                    <input type="text" id="serverNameInput" class="form-control bg-secondary border-0 text-white" placeholder="Harika Sunucum">
                </div>
                <div class="modal-footer border-0">
                    <button class="btn btn-primary w-100 fw-bold" style="background: var(--accent); border:0" onclick="createNewServer()">Oluştur</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>

    <script>
        const currentUserName = "@Model.UserName";
        let allFriendsData = [];

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .withAutomaticReconnect()
            .build();

        connection.start().then(() => {
            console.log("SignalR Bağlandı.");
            loadFriends();
        }).catch(err => console.error("Bağlantı Hatası: ", err));

        connection.on("UserStatusChanged", function(username, isOnline) {
            loadFriends();
        });

        connection.on("ReceivePrivateMessage", function (sender, receiver, message, time) {
            const activeChat = $('#chatHeaderName').text();
            // Eğer mesaj bana geldiyse ve o pencere açıksa VEYA mesajı ben gönderdiysem
            if (activeChat === sender || (sender === currentUserName && activeChat === receiver)) {
                appendMessage(sender, message, time);
            }
        });

        connection.on("ReceiveFriendRequest", function (senderName, targetName) {
            if (currentUserName.toLowerCase() !== targetName.toLowerCase()) return;
            $('#pendingRequestsList .empty-msg').remove();
            const requestHtml = `
                <div class="request-card d-flex align-items-center justify-content-between p-3 rounded-3 mb-2 animate__animated animate__fadeInLeft">
                    <div class="d-flex align-items-center">
                        <div class="user-avatar me-3" style="width: 40px; height: 40px; background: var(--accent); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold;">
                            ${senderName[0].toUpperCase()}
                        </div>
                        <div><div class="fw-bold">${senderName}</div><div class="text-muted small">İstek gönderdi</div></div>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-success btn-sm rounded-pill px-3" onclick="respondRequest('${senderName}', true, this)">Onayla</button>
                        <button class="btn btn-danger btn-sm rounded-pill px-3" onclick="respondRequest('${senderName}', false, this)">Reddet</button>
                    </div>
                </div>`;
            $('#pendingRequestsList').prepend(requestHtml);
            if(!$('#pendingArea').is(':visible') && $('#notif-dot').length === 0) {
                $('.top-nav-btn:contains("Bekleyenler")').append('<span class="badge bg-danger ms-1" id="notif-dot">•</span>');
            }
        });

        function loadFriends() {
            $.get('/Friend/GetFriends', function(friends) {
                allFriendsData = friends;
                renderFriendsList();
            });
        }

        function renderFriendsList() {
            const activeTab = $('.top-nav-btn.active').text().trim();
            let html = '';
            let dmHtml = '';

            allFriendsData.forEach(f => {
                const statusColor = f.isOnline ? 'var(--accent-green)' : '#747f8d';
                const statusText = f.isOnline ? 'Çevrimiçi' : 'Çevrimdışı';

                const card = `
                    <div class="nav-item d-flex align-items-center justify-content-between p-2 mb-1 rounded-2" onclick="openPrivateChat('${f.username}')">
                        <div class="d-flex align-items-center">
                            <div class="position-relative me-3">
                                <div class="user-avatar" style="width: 38px; height: 38px; background: #333; border-radius: 50%; display: flex; align-items: center; justify-content: center;">${f.username[0].toUpperCase()}</div>
                                <div style="width: 12px; height: 12px; background: ${statusColor}; border-radius: 50%; position: absolute; bottom: 0; right: 0; border: 2px solid var(--chat-bg);"></div>
                            </div>
                            <div>
                                <div class="fw-bold">${f.username}</div>
                                <div class="small text-muted">${statusText}</div>
                            </div>
                        </div>
                    </div>`;

                dmHtml += card;
                if (activeTab === "Tümü") html += card;
                else if (activeTab === "Çevrimiçi" && f.isOnline) html += card;
            });

            $('#friendsListArea').html(html || '<div class="text-center mt-5 opacity-25">Burada gösterilecek kimse yok.</div>');
            $('#directMessagesList').html(dmHtml);
        }

        function sendFriendRequest() {
            const username = $('#friendUsernameInput').val().trim();
            if (!username) return;
            connection.invoke("SendFriendRequest", username).then(() => {
                $('#addFriendStatus').html('<div class="text-success small">İstek gönderildi!</div>');
                $('#friendUsernameInput').val('');
            }).catch(err => $('#addFriendStatus').html(`<div class="text-danger small">${err.message}</div>`));
        }

        function respondRequest(senderName, isAccepted, btnElement) {
            if(isAccepted) {
                $.post('/Friend/AcceptRequest', { senderName: senderName }, () => loadFriends());
            }
            $(btnElement).closest('.request-card').remove();
        }

        function openPrivateChat(username) {
            $('#friendsView').addClass('hidden').removeClass('d-flex');
            $('#chatView').removeClass('hidden').addClass('d-flex');
            $('#chatHeaderName').text(username);
            $('#messageList').html(`<div class="text-center p-5 opacity-25">Sohbet yükleniyor...</div>`);

            // --- VERİTABANINDAN GEÇMİŞİ ÇEK ---
            $.get(`/Friend/GetChatHistory?withUser=${username}`, function (messages) {
                $('#messageList').empty();
                if (messages.length === 0) {
                    $('#messageList').html(`<div class="text-center p-5 opacity-25"><b>${username}</b> ile sohbetin başlangıcı.</div>`);
                } else {
                    messages.forEach(m => {
                        appendMessage(m.sender, m.content, m.time);
                    });
                }
            });

            $('.nav-item').removeClass('active');
            $('#chatInput').focus();
        }

        function appendMessage(sender, message, time) {
            const isMe = sender === currentUserName;
            const html = `
                <div class="message-item animate__animated animate__fadeInUp animate__faster">
                    <div class="d-flex align-items-baseline">
                        <span class="msg-sender" style="color: ${isMe ? 'var(--success)' : 'var(--accent)'}">${sender}</span>
                        <span class="msg-time">${time}</span>
                    </div>
                    <div class="msg-content">${message}</div>
                </div>`;
            $('#messageList').append(html);
            const container = document.getElementById('messageList');
            container.scrollTop = container.scrollHeight;
        }

        $('#chatInput').keypress(function (e) {
            if (e.which == 13) {
                const msg = $(this).val().trim();
                const receiver = $('#chatHeaderName').text();
                if (msg && receiver !== "genel") {
                    connection.invoke("SendMessage", receiver, msg).catch(err => console.error(err));
                    $(this).val('');
                }
            }
        });

        function switchFriendTab(tab, btn) {
            $('.top-nav-btn').removeClass('active');
            $(btn).addClass('active');
            if(tab === 'pending') $('#notif-dot').remove();

            $('#friendsListArea, #pendingArea, #addFriendArea').addClass('hidden');
            if (tab === 'online' || tab === 'all') {
                $('#friendsListArea').removeClass('hidden');
                renderFriendsList();
            }
            else if (tab === 'pending') $('#pendingArea').removeClass('hidden');
            else if (tab === 'add') $('#addFriendArea').removeClass('hidden');
        }

        function showHome() {
            $('#friendsView').removeClass('hidden').addClass('d-flex');
            $('#chatView').addClass('hidden').removeClass('d-flex');
            $('.server-icon').removeClass('active');
            $('#homeIcon').addClass('active');
            $('#leftPanelHeader').text('DoWeTalk');
            loadFriends();
        }

        function createNewServer() {
            const name = $('#serverNameInput').val().trim();
            if (!name) return;
            const id = "srv_" + Date.now();
            $('#serverListContainer').append(`<div class="server-icon" id="${id}" onclick="selectServer('${id}', '${name}')">${name[0].toUpperCase()}</div>`);
            $('#createServerModal').modal('hide');
            $('#serverNameInput').val('');
        }

        function selectServer(id, name) {
            $('#friendsView').addClass('hidden').removeClass('d-flex');
            $('#chatView').removeClass('hidden').addClass('d-flex');
            $('.server-icon').removeClass('active');
            $(`#${id}`).addClass('active');
            $('#leftPanelHeader').text(name);
            $('#chatHeaderName').text('genel');
            $('#messageList').html(`<div class="text-center p-5 opacity-50 mt-5"><h2>#genel kanalına hoş geldin!</h2></div>`);
        }
    </script>
</body>
</html>