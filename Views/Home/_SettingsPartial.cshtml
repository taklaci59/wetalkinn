                        <div class="theme-card" onclick="changeTheme('theme-nord')" data-theme-name="theme-nord">
                            <div class="theme-preview"><div class="preview-sidebar" style="background: #292e39;"></div><div class="preview-content" style="background: #2e3440;"><div class="preview-accent" style="background: #88c0d0;"></div></div></div>
                            <div class="theme-name">Nord</div>
                        </div>
                        <div class="theme-card" onclick="changeTheme('theme-tokyo-night')" data-theme-name="theme-tokyo-night">
                            <div class="theme-preview"><div class="preview-sidebar" style="background: #16161e;"></div><div class="preview-content" style="background: #1a1b26;"><div class="preview-accent" style="background: #7aa2f7;"></div></div></div>
                            <div class="theme-name">Tokyo Night</div>
                        </div>
                        <div class="theme-card" onclick="changeTheme('theme-one-dark')" data-theme-name="theme-one-dark">
                            <div class="theme-preview"><div class="preview-sidebar" style="background: #21252b;"></div><div class="preview-content" style="background: #282c34;"><div class="preview-accent" style="background: #61afef;"></div></div></div>
                            <div class="theme-name">One Dark</div>
                        </div>
                        <div class="theme-card" onclick="changeTheme('theme-ayu-dark')" data-theme-name="theme-ayu-dark">
                            <div class="theme-preview"><div class="preview-sidebar" style="background: #0d1017;"></div><div class="preview-content" style="background: #0b0e14;"><div class="preview-accent" style="background: #e6b450;"></div></div></div>
                            <div class="theme-name">Ayu Dark</div>
                        </div>
                    </div>
                </div>

                <div class="theme-category mb-5">
                    <h6 class="text-uppercase small fw-bold text-2 mb-3" style="letter-spacing: 0.12em; font-size: 11px;">🕹️ RETRO & VIBRANT</h6>
                    <div class="theme-grid">
                        <div class="theme-card" onclick="changeTheme('theme-gruvbox-dark')" data-theme-name="theme-gruvbox-dark">
                            <div class="theme-preview"><div class="preview-sidebar" style="background: #1d2021;"></div><div class="preview-content" style="background: #282828;"><div class="preview-accent" style="background: #fabd2f;"></div></div></div>
                            <div class="theme-name">Gruvbox Dark</div>
                        </div>
                        <div class="theme-card" onclick="changeTheme('theme-gruvbox-light')" data-theme-name="theme-gruvbox-light">
                            <div class="theme-preview"><div class="preview-sidebar" style="background: #f2e5bc;"></div><div class="preview-content" style="background: #fbf1c7;"><div class="preview-accent" style="background: #d65d0e;"></div></div></div>
                            <div class="theme-name">Gruvbox Light</div>
                        </div>
                        <div class="theme-card" onclick="changeTheme('theme-solarized-dark')" data-theme-name="theme-solarized-dark">
                            <div class="theme-preview"><div class="preview-sidebar" style="background: #073642;"></div><div class="preview-content" style="background: #002b36;"><div class="preview-accent" style="background: #2aa198;"></div></div></div>
                            <div class="theme-name">Solarized Dark</div>
                        </div>
                        <div class="theme-card" onclick="changeTheme('theme-monokai-pro')" data-theme-name="theme-monokai-pro">
                            <div class="theme-preview"><div class="preview-sidebar" style="background: #221f22;"></div><div class="preview-content" style="background: #2d2a2e;"><div class="preview-accent" style="background: #ffd866;"></div></div></div>
                            <div class="theme-name">Monokai Pro</div>
                        </div>
                        <div class="theme-card" onclick="changeTheme('theme-synthwave84')" data-theme-name="theme-synthwave84">
                            <div class="theme-preview"><div class="preview-sidebar" style="background: #1e1a2b;"></div><div class="preview-content" style="background: #262335;"><div class="preview-accent" style="background: #ff7edb;"></div></div></div>
                            <div class="theme-name">SynthWave '84</div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="section-voice" class="settings-section">
                <h3 class="fw-bold mb-4">Ses ve Görüntü</h3>
                
                <div class="volume-group" style="background: var(--surface-3); border-color: var(--border-subtle);">
                    <label class="small fw-bold text-2 mb-2 text-uppercase" style="letter-spacing: 0.05em;">Giriş Cihazı</label>
                    <select id="micSelect" class="form-select border-0 p-3 mb-3" style="background: var(--surface-1); color: var(--text-1);"></select>
                    
                    <label class="small fw-bold text-2 mb-1 text-uppercase" style="letter-spacing: 0.05em;">GİRİŞ SESİ (%<span id="inputVolLabel">80</span>)</label>
                    <input type="range" class="form-range vol-slider" data-type="input" min="0" max="100" value="80">
                </div>

                <div class="volume-group" style="background: var(--surface-3); border-color: var(--border-subtle);">
                    <label class="small fw-bold text-2 mb-2 text-uppercase" style="letter-spacing: 0.05em;">Çıkış Cihazı</label>
                    <select id="speakerSelect" class="form-select border-0 p-3 mb-3" style="background: var(--surface-1); color: var(--text-1);"></select>
                    
                    <label class="small fw-bold text-2 mb-1 text-uppercase" style="letter-spacing: 0.05em;">ÇIKIŞ SESİ (%<span id="outputVolLabel">100</span>)</label>
                    <input type="range" class="form-range vol-slider" data-type="output" min="0" max="100" value="100">
                </div>

                <div class="p-4 rounded-4 mb-4 shadow-sm border border-subtle" style="background: var(--surface-3);">
                    <label class="small fw-bold text-2 mb-3 d-block text-uppercase" style="letter-spacing: 0.05em;">Mikrofon Testi</label>
                    <button id="testMicBtn" class="btn btn-primary mb-3 w-100 fw-bold py-2" onclick="testMicrophone()">
                        <i class="bi bi-mic-fill me-2"></i>Mikrofonu Test Et
                    </button>
                    <div id="micSegmentContainer" class="mic-segment-container" style="background: var(--surface-1);">
                        @for (int i = 0; i < 50; i++)
                        {
                            <div class="mic-segment" style="background: var(--surface-ghost);"></div>
                        }
                    </div>
                    <div class="small text-3 mt-3 text-center">Ses sinyallerini burada görebilirsiniz.</div>
                </div>
            </div>
        </div>
    </div>
</div>

